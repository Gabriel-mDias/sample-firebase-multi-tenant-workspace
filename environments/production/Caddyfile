# Proxy reverso e TLS do App.
#
# O Caddy emite e renova os certificados sozinho pelo Let's Encrypt, usando o desafio HTTP-01 na
# porta 80 — que por isso não é opcional. Ele também redireciona HTTP para HTTPS por padrão, sem
# configuração.
#
# ANTES DO PRIMEIRO `up`: confirme que os três subdomínios já resolvem para o IP da VPS. Emissão com
# DNS errado falha, e o Let's Encrypt limita tentativas por semana — errar aqui custa espera, não só
# um retry. Ver environments/vps/02-dns-e-dominio.md.
{
	email {$ACME_EMAIL}
}

# Interface (SPA Angular servida por nginx).
{$APP_DOMAIN} {
	encode gzip zstd
	reverse_proxy app-frontend:80

	header {
		# O env.js carrega a configuração de runtime e MUDA entre deploys da mesma imagem.
		# Cacheá-lo deixaria o navegador apontando para o ambiente anterior.
		?Cache-Control "no-store"
		-Server

		# --- Cabeçalhos de segurança ---------------------------------------------------------
		# Ficam SÓ aqui, não no nginx da imagem do frontend: o Caddy é a borda e é onde o TLS
		# termina. Declarar nos dois lugares cria a dúvida de qual vence.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# --- CSP, em REPORT-ONLY -------------------------------------------------------------
		# Ela NÃO bloqueia nada ainda: reporta violação no console do navegador. Promover para
		# `Content-Security-Policy` só depois de exercitar login, wizard, upload, chancela e
		# esteira com o console limpo. Ligar bloqueante sem observar é aplicar denyAll() sem teste.
		#
		# Cada diretiva abaixo foi medida contra o dist/ real, não suposta:
		#
		#  script-src 'self'      o build de produção não emite script inline (medido: 0), e os
		#                         dois <script src> são same-origin. Depende de
		#                         `inlineCritical: false` no angular.json, que remove o handler
		#                         onload inline do <link rel=stylesheet>, e de o
		#                         silent-check-sso.html carregar .js externo.
		#  style-src 'unsafe-inline'  o Angular injeta estilo de componente em runtime, e o
		#                         SweetAlert2 que vem da SDK também. ngCspNonce cobriria o Angular,
		#                         não o SweetAlert2.
		#  connect-src            a SPA chama a API cross-origin (não há proxy) e o Keycloak, para
		#                         token e userinfo.
		#  frame-src              keycloak-js usa silentCheckSsoRedirectUri: o iframe NAVEGA até o
		#                         Keycloak antes de voltar para /silent-check-sso.html.
		#  font-src 'self'        Font Awesome 7 e Inter vêm de node_modules, servidos same-origin.
		#                         Não há CDN em lugar nenhum.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://{$API_DOMAIN} https://{$AUTH_DOMAIN}; frame-src 'self' https://{$AUTH_DOMAIN}; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}
}

# API.
{$API_DOMAIN} {
	encode gzip zstd
	reverse_proxy app-backend:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Provedor de identidade.
{$AUTH_DOMAIN} {
	encode gzip zstd

	# --- Console administrativo FECHADO -------------------------------------------------------
	# O console do Keycloak administra o realm `master`, cuja conta é a chave-mestra da identidade
	# do sistema. E o app-realm.yaml configura SÓ o app-realm: o `master` fica nos defaults do
	# Keycloak, onde bruteForceProtected é FALSE. Publicar isso na internet é oferecer um painel de
	# administração de identidade sem proteção contra força bruta.
	#
	# 404 e não 403: 403 confirma que existe algo ali.
	#
	# ISTO NÃO QUEBRA O BACKEND. Ele fala com a Admin API pelo endereço INTERNO
	# (KEYCLOAK_SERVER_URL=http://app-keycloak:8080 no compose), sem passar pelo Caddy — então
	# AutorizacaoBootstrap e KeycloakUserService seguem funcionando. É isto que torna a decisão
	# barata. Verificado antes de fechar.
	#
	# Para administrar: túnel SSH, que já exige a chave que o vps/01 mandou instalar.
	#     ssh -L 8080:app-keycloak:8080 app@SEU_IP
	@console path /admin* /realms/master/*
	respond @console 404

	# O Keycloak monta URLs de redirecionamento a partir dos cabeçalhos encaminhados. Sem eles — e
	# sem o KC_PROXY_HEADERS=xforwarded do compose — ele devolveria endereços http://app-keycloak
	# internos no meio do fluxo de login.
	reverse_proxy app-keycloak:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

# =========================================================================================
# STAGING
#
# Os três blocos abaixo servem o ambiente de homologação, que roda na MESMA máquina, em outra
# stack Compose (`app-staging`). Este Caddy é o único da VPS e participa das duas redes. A
# consequência incômoda, e ela precisa estar dita: **derrubar a stack de produção derruba também
# o acesso a staging**, porque a borda mora aqui.
#
# Os três subdomínios de staging precisam resolver para o IP da VPS antes do primeiro `up`,
# exatamente como os de produção. São seis certificados, não três.
# =========================================================================================

# Interface de staging.
{$STAGING_APP_DOMAIN} {
	encode gzip zstd
	reverse_proxy app-staging-frontend:80

	header {
		?Cache-Control "no-store"
		-Server

		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

		# Mesma CSP em report-only de produção, apontando para os domínios de staging. Ela fica
		# report-only aqui TAMBÉM: promover a bloqueante é decisão da rodada de publicação, e
		# staging é justamente onde as violações serão observadas antes disso.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://{$STAGING_API_DOMAIN} https://{$STAGING_AUTH_DOMAIN}; frame-src 'self' https://{$STAGING_AUTH_DOMAIN}; frame-ancestors 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
	}
}

# API de staging.
{$STAGING_API_DOMAIN} {
	encode gzip zstd
	reverse_proxy app-staging-backend:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

# Provedor de identidade de staging.
{$STAGING_AUTH_DOMAIN} {
	encode gzip zstd

	# O console fica fechado em staging pelo MESMO motivo de produção, e não por simetria estética:
	# o realm `master` desta instância também nasce com bruteForceProtected falso. Ser ambiente de
	# teste não torna um painel de administração de identidade sem proteção contra força bruta menos
	# perigoso — ele dá acesso à mesma máquina.
	@console path /admin* /realms/master/*
	respond @console 404

	reverse_proxy app-staging-keycloak:8080

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}
