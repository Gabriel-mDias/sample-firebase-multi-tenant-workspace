# Contrato de variáveis do ambiente PUBLICADO.
#
# Copie para `.env` NA VPS, preencha com valores reais e restrinja a permissão:
#
#     cp .env.example .env && chmod 600 .env
#
# O `.env` real NUNCA vai para o Git — o .gitignore da raiz o bloqueia. Este arquivo de exemplo é o
# único versionado, e não pode conter nenhum valor verdadeiro.
#
# Quase todas as variáveis abaixo são obrigatórias: o compose usa `${VAR:?}` e a subida FALHA se
# faltar alguma, em vez de silenciosamente cair num valor de desenvolvimento.

# --- Domínios -----------------------------------------------------------------------------------
# Os três precisam ter registro A apontando para o IP da VPS ANTES do primeiro `up`.
APP_DOMAIN=app.seudominio.com.br
API_DOMAIN=api.seudominio.com.br
AUTH_DOMAIN=auth.seudominio.com.br

# Endereço para onde o Let's Encrypt manda aviso de expiração. Use um que você leia.
ACME_EMAIL=voce@seudominio.com.br

# --- Imagens ------------------------------------------------------------------------------------
# Dono do repositório no GitHub, em minúsculas — compõe ghcr.io/<owner>/app-backend.
GHCR_OWNER=seu-usuario-github
IMAGE_TAG=latest

# --- Postgres -----------------------------------------------------------------------------------
# Gere cada senha com algo como `openssl rand -base64 24`. Não reaproveite entre si.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=

APP_DB_NAME=app-db
APP_DB_USER=app-access
APP_DB_PASSWORD=

KEYCLOAK_DB_NAME=keycloak-db
KEYCLOAK_DB_USER=keycloak-access
KEYCLOAK_DB_PASSWORD=

# --- Keycloak -----------------------------------------------------------------------------------
# Administrador do realm `master`. É a chave-mestra da identidade: trate como o segredo mais
# sensível do arquivo.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Segredo do cliente confidencial que o backend usa na Admin API.
KEYCLOAK_BACKEND_CLIENT_SECRET=

# Administrador DA APLICAÇÃO, dentro do realm `app-realm` — é com este que você entra na interface.
# A senha precisa atender à política do realm: mínimo 12, com minúscula, maiúscula e caractere
# especial, e diferente do login e do e-mail (subiu de 8 para 12 na PF-11).
#
# ⚠️ Se ela NÃO passar na política, o `app-keycloak-config` aborta — e como o backend depende dele
# com `service_completed_successfully`, o backend não sobe. A falha aparece no log daquele contêiner,
# não no do backend.
APP_ADMIN_EMAIL=
APP_ADMIN_PASSWORD=

# --- Endurecimento (PF-11) ----------------------------------------------------------------------
# Segunda camada, não a primeira. O SecurityConfig já exige autenticação em /actuator/** (exceto o
# health) e o application.yml já traz estes mesmos valores como default — declarados aqui para que
# quem ler o .env saiba que a decisão existe, em vez de descobri-la lendo código Java.
#
# ACTUATOR_EXPOSURE: `metrics` publica /actuator/metrics/http.server.requests, que ENUMERA todos os
# URIs da API com contagem e latência. Nunca ligue em ambiente publicado.
ACTUATOR_EXPOSURE=health

# SPRINGDOC_ENABLED: `true` publica o contrato inteiro da API — 58 endpoints, todos os DTOs e enums,
# e as descrições que explicam as regras de negócio. Útil em desenvolvimento, não em produção.
SPRINGDOC_ENABLED=false

# --- AWS ----------------------------------------------------------------------------------------
# Bucket da APLICAÇÃO (upload de documentos). O bucket de BACKUP é outro, com credencial própria, e
# é configurado no scripts/pg-backup.sh — não aqui. Separá-los é o que impede que um vazamento da
# credencial da aplicação alcance as cópias de segurança.
AWS_REGION=us-east-1
AWS_ENDPOINT=https://s3.us-east-1.amazonaws.com
AWS_S3_BUCKET=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=
