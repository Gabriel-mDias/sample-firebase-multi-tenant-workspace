# Ambiente de desenvolvimento.
#
# Este arquivo é o CONTRATO de variáveis, e é versionado. Ele existe para documentar o que o compose
# aceita — não para ser copiado como está para outro lugar. Os valores abaixo são de brincar e ficam
# no repositório de propósito: são as mesmas credenciais que já estavam no compose antigo, e nada
# aqui protege nada. Em produção, use environments/production/.env.example e valores gerados.
#
# O compose local traz TODOS estes valores como default embutido, então `docker compose up -d`
# funciona sem nenhum .env. Crie um só se quiser divergir de algum valor.

# --- Postgres -----------------------------------------------------------------------------------
POSTGRES_SUPERUSER=root
POSTGRES_SUPERUSER_PASSWORD=root

APP_DB_NAME=app-db
APP_DB_USER=app-access
APP_DB_PASSWORD=app@LocalDev2026!

KEYCLOAK_DB_NAME=keycloak-db
KEYCLOAK_DB_USER=keycloak-access
KEYCLOAK_DB_PASSWORD=!security@access.g&ms

# --- Keycloak -----------------------------------------------------------------------------------
# Administrador do realm `master` (console em http://localhost:8443).
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin@LocalDev2026

KEYCLOAK_SSL_REQUIRED=external
KEYCLOAK_BACKEND_CLIENT_SECRET=app-backend-local-secret

# Usuário administrador DA APLICAÇÃO, dentro do realm `app-realm`.
# A senha da aplicação precisa satisfazer a política do realm, que espelha o
# PasswordUtil do backend — mínimo de 12 caracteres, com maiúscula, dígito e símbolo.
APP_ADMIN_EMAIL=admin.app@gems.local
APP_ADMIN_PASSWORD=Admin@app2026

# --- Aplicação ----------------------------------------------------------------------------------
APP_ORIGIN=http://localhost:4200
