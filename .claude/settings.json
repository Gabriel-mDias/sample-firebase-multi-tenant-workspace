{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./frontend/node_modules/**)",
      "Read(./frontend/.angular/**)",
      "Read(./frontend/dist/**)",
      "Read(./backend/**/target/**)",
      "Read(./business/**/*.png)",
      "Read(./backend/.m2/settings.xml)",
      "Read(./frontend/.npmrc)"
    ]
  }
}
