<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!--
        Endereço internacional.

        ENDERECO nasceu em changelog-normalizacao.xml com ID_ESTADO e CD_CEP obrigatórios, e o país
        alcançado apenas por navegação (endereco.estado.pais). O cadastro precisa aceitar endereço
        fora do Brasil, com CEP e Estado opcionais — e sem estado, não há país. Daí a coluna
        ID_PAIS própria.

        A obrigatoriedade condicional ("no Brasil, estado e CEP são obrigatórios") deixa de ser
        garantia do banco e passa a viver no EnderecoService, coberta por teste dedicado. É
        consequência inevitável de tornar as colunas nuláveis, registrada no plan.md como ponto de
        atenção.

        ORDEM OBRIGATÓRIA: o backfill (2) precede o NOT NULL (3). Invertidos, o changeset falha no
        boot com dado existente. A pré-condição — nenhum endereço órfão de estado — foi conferida
        antes de aplicar (tasks.md T003).

        Nenhum changeset de changelog-normalizacao.xml é editado: alteração de schema já aplicado
        corrige-se com changeset novo (Princípio III).
    -->

    <changeSet id="add-column-pais-endereco" author="app">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="ENDERECO" columnName="ID_PAIS"/>
            </not>
        </preConditions>
        <comment>
            País do endereço, ainda anulável para permitir o backfill do changeset seguinte.
        </comment>
        <addColumn tableName="ENDERECO">
            <column name="ID_PAIS" type="UUID"/>
        </addColumn>
    </changeSet>

    <changeSet id="backfill-pais-endereco" author="app">
        <comment>
            Deriva o país de cada endereço já gravado a partir do ESTADO que ele referenciava — que
            até aqui era obrigatório, e por isso a derivação é total. Precede obrigatoriamente o
            NOT NULL do changeset seguinte.

            Identificadores sem aspas de propósito: Postgres dobra para minúsculo, que é como as
            tabelas existem fisicamente (o Liquibase e o Hibernate também emitem sem aspas).
        </comment>
        <sql>
            UPDATE ENDERECO
            SET ID_PAIS = (SELECT e.ID_PAIS FROM ESTADO e WHERE e.ID_ESTADO = ENDERECO.ID_ESTADO)
            WHERE ID_PAIS IS NULL;
        </sql>
        <rollback>
            UPDATE ENDERECO SET ID_PAIS = NULL;
        </rollback>
    </changeSet>

    <changeSet id="add-not-null-pais-endereco" author="app">
        <comment>
            Torna o país obrigatório e o amarra ao cadastro de referência. Falha aqui significa
            backfill incompleto — o que é o comportamento desejado: falha alta, nunca dado
            silenciosamente órfão.
        </comment>
        <addNotNullConstraint tableName="ENDERECO" columnName="ID_PAIS" columnDataType="UUID"/>
        <addForeignKeyConstraint
                baseTableName="ENDERECO"
                baseColumnNames="ID_PAIS"
                constraintName="FK_ENDERECO_PAIS"
                referencedTableName="PAIS"
                referencedColumnNames="ID_PAIS"/>
    </changeSet>

    <changeSet id="create-index-endereco-pais" author="app">
        <comment>Índice de apoio para filtrar e juntar endereços por país, espelhando IDX_ENDERECO_ESTADO.</comment>
        <createIndex indexName="IDX_ENDERECO_PAIS" tableName="ENDERECO">
            <column name="ID_PAIS"/>
        </createIndex>
    </changeSet>

    <changeSet id="drop-not-null-estado-cep-endereco" author="app">
        <comment>
            Estado e CEP passam a ser opcionais: são exigências brasileiras, não universais. Um
            endereço fora do Brasil não tem UF nem CEP no formato do país. A regra condicional vive
            agora no EnderecoService.
        </comment>
        <dropNotNullConstraint tableName="ENDERECO" columnName="ID_ESTADO" columnDataType="UUID"/>
        <dropNotNullConstraint tableName="ENDERECO" columnName="CD_CEP" columnDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
