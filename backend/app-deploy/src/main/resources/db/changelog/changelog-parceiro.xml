<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!--
        Domínio parceiro: PARCEIRO estende EntidadeAuditavel e referencia PESSOA, CONTATO e ENDERECO
        (changelog-normalizacao.xml). Por isso este arquivo é incluído depois deles no
        changelog-master.xml.
    -->

    <changeSet id="create-table-parceiro" author="app">
        <comment>
            Parceiro.java: nome, descrição e comissão próprios, mais três referências normalizadas.
            Estende EntidadeAuditavel (DT_CRIACAO obrigatória, DT_EXCLUSAO opcional).

            Propositalmente SEM UNIQUE em NM_PARCEIRO: a regra de negócio é "nome único apenas entre
            registros não excluídos" (soft delete), que uma constraint UNIQUE de banco não expressa
            corretamente — um nome liberado por exclusão lógica precisa poder ser reutilizado. Essa
            validação vive só no ParceiroService, nunca no schema.

            NR_SOLICITACOES_CONCLUIDAS é mantido pelo listener do evento de conclusão, nunca por
            escrita direta do domínio solicitacao. Nasce com DEFAULT 0 para que a coluna possa ser
            NOT NULL sem exigir backfill.
        </comment>
        <createTable tableName="PARCEIRO">
            <column name="ID_PARCEIRO" type="UUID" defaultValueComputed="${uuid_function}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="NM_PARCEIRO" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="DS_PARCEIRO" type="VARCHAR(4000)"/>
            <column name="VL_COMISSAO" type="NUMERIC(5,2)"/>
            <column name="NR_SOLICITACOES_CONCLUIDAS" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="ID_PESSOA" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_PARCEIRO_PESSOA" references="PESSOA(ID_PESSOA)"/>
            </column>
            <column name="ID_CONTATO" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_PARCEIRO_CONTATO" references="CONTATO(ID_CONTATO)"/>
            </column>
            <column name="ID_ENDERECO" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_PARCEIRO_ENDERECO" references="ENDERECO(ID_ENDERECO)"/>
            </column>
            <column name="DT_CRIACAO" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="DT_EXCLUSAO" type="TIMESTAMP"/>
        </createTable>
    </changeSet>

    <changeSet id="create-index-parceiro-nome" author="app">
        <comment>Índice de apoio para busca por nome (sem UNIQUE — ver comentário acima).</comment>
        <createIndex indexName="IDX_PARCEIRO_NOME" tableName="PARCEIRO">
            <column name="NM_PARCEIRO"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-index-parceiro-pessoa" author="app">
        <comment>Índice de apoio para localizar o parceiro a partir da identidade civil.</comment>
        <createIndex indexName="IDX_PARCEIRO_PESSOA" tableName="PARCEIRO">
            <column name="ID_PESSOA"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
