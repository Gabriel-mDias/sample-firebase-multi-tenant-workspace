<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.1.xsd">

    <!--
        Domínio localidades: PAIS e ESTADO são dados de referência puros (não estendem
        EntidadeAuditavel — sem auditoria, sem soft delete), usados por normalizacao/endereço.
        Inclui a massa inicial de Brasil e das 27 unidades federativas brasileiras, por seed
        idempotente (Princípio III), nunca por script manual ou código de aplicação.
    -->

    <changeSet id="create-table-pais" author="app">
        <comment>
            Tabela de referência para países. Pais.java não estende EntidadeAuditavel: é dado de
            referência compartilhado, sem auditoria e sem soft delete.
        </comment>
        <createTable tableName="PAIS">
            <column name="ID_PAIS" type="UUID" defaultValueComputed="${uuid_function}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="NM_PAIS" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="create-table-estado" author="app">
        <comment>
            Tabela de referência para estados/unidades federativas, vinculada ao país. Estado.java
            também não estende EntidadeAuditavel — mesmo motivo de PAIS.
        </comment>
        <createTable tableName="ESTADO">
            <column name="ID_ESTADO" type="UUID" defaultValueComputed="${uuid_function}">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="ID_PAIS" type="UUID">
                <constraints nullable="false" foreignKeyName="FK_ESTADO_PAIS" references="PAIS(ID_PAIS)"/>
            </column>
            <column name="NM_ESTADO" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="NM_SIGLA_ESTADO" type="VARCHAR(2)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="seed-pais" author="app">
        <comment>
            Massa inicial de países de referência. Acrescente aqui os países que o negócio precisar — este
            é dado de referência, carregado por seed idempotente. IDs gerados pelo defaultValueComputed, não
            fixados aqui.
        </comment>
        <insert tableName="PAIS">
            <column name="NM_PAIS" value="Brasil"/>
        </insert>
    </changeSet>

    <changeSet id="seed-estado-brasil" author="app">
        <comment>
            Massa inicial das 27 unidades federativas brasileiras (26 estados + Distrito Federal).
            ID_PAIS resolvido por subselect em PAIS pelo nome, sem fixar UUID literal.
        </comment>
        <insert tableName="ESTADO">
            <column name="ID_PAIS" valueComputed="(SELECT ID_PAIS FROM PAIS WHERE NM_PAIS = 'Brasil')"/>
            <column name="NM_ESTADO" value="Acre"/>
            <column name="NM_SIGLA_ESTADO" value="AC"/>
