{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gems.example/schemas/gems-ai.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "profile"],
  "properties": {
    "version": { "const": "2.0.0" },
    "profile": { "enum": ["java", "angular", "workspace"] },
    "waivers": {
      "type": "array",
      "items": { "$ref": "#/$defs/waiver" },
      "default": []
    }
  },
  "$defs": {
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "scope", "justification", "owner", "expires", "compensation", "approvedBy"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "justification": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "expires": { "type": "string", "format": "date" },
        "compensation": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": "string", "minLength": 1 }
      }
    }
  }
}
